{
    "manifest_version": 1,
    "name": "LyricBar",
    "slug": "LyricBar",
    "author": "solstice23",
    "author_links": [
        "https://github.com/solstice23"
    ],
    "description": "重新设计的软件内词栏",
    "preview": "preview.png",
    "version": "0.3.6",
    "type": "extension",
    "ncm3-compatible": true,
    "requirements": [
        "RefinedNowPlaying"
    ],
    "loadAfter": [
        "RefinedNowPlaying"
    ],
    "betterncm_version": ">=1.0.0",
